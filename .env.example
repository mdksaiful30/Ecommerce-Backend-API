APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Product image uploads
PRODUCT_IMAGE_DISK=public
PRODUCT_IMAGE_DIRECTORY=products
PRODUCT_IMAGE_MAX_SIZE=5120
PRODUCT_IMAGE_MAX_COUNT=10
PRODUCT_IMAGE_MIMES=jpg,jpeg,png,webp,gif

# Category image uploads
CATEGORY_IMAGE_DISK=public
CATEGORY_IMAGE_DIRECTORY=categories
CATEGORY_IMAGE_MAX_SIZE=5120
CATEGORY_IMAGE_MAX_COUNT=10
CATEGORY_IMAGE_MIMES=jpg,jpeg,png,webp,gif

# Cart settings
CART_TAX_RATE=0
CART_MAX_QUANTITY=100

# Stripe payments
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=usd
PAYMENT_METHODS=card
PAYMENT_CAPTURE_METHOD=automatic
# Modern Stripe accounts manage payment methods from the Dashboard (recommended).
PAYMENT_AUTOMATIC_PAYMENT_METHODS=true
PAYMENT_RETURN_URL=
# Test-only: allow confirming a PaymentIntent server-side (Postman testing). Keep false in production.
PAYMENT_ALLOW_MANUAL_CONFIRMATION=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
